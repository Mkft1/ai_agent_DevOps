# Путь к kubeconfig-файлу для доступа к Kubernetes-кластеру
KUBECONFIG_PATH=~/.kube/config

# Базовый URL Prometheus для запроса метрик
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090

# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Формат логов: text (человекочитаемый) | json (structured logging для Loki/CloudWatch)
LOG_FORMAT=text

# Демо/оффлайн-режим: при отсутствии LLM-ключа /diagnose отвечает stub-диагнозом
# (LLMClientStub) вместо честного 503. Для прода держите false.
LLM_OFFLINE=false

# Ключ API LLM-providera (используйте один из двух)
OPENAI_API_KEY=sk-xxxxx...xxxx
QWEN_API_KEY=sk-xxxxx...xxxx

# LLM API (OpenAI-совместимый: Qwen/DashScope, OpenAI, vLLM, Ollama)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
LLM_MODEL=qwen-max

# --- Guardrails (ограничения безопасности агента) ---
# Список namespace'ов, к которым агенту разрешён доступ (JSON-массив или через запятую)
ALLOWED_NAMESPACES=["default"]
# Максимальное количество строк лога, которое агент заберёт у пода
MAX_LOG_LINES=200
# Разрешить агенту write-действия (delete/exec/apply). По умолчанию false — только чтение
ENABLE_WRITE_ACTIONS=false

# --- Маскирование PII/секретов перед отправкой в LLM (Data Privacy) ---
# Маскировать JWT, API-ключи (sk-/ghp_/AKIA/key-), пароли в URL, Bearer-токены
# и email в логах подов и K8s-событиях ПЕРЕД отправкой контекста в LLM
# (замена на [REDACTED:<type>]). Обязательно для Enterprise-compliance;
# отключайте (false) только для доверенных локальных моделей (например, Ollama).
ENABLE_SCRUBBING=true
# Дополнительно маскировать IPv4-адреса. По умолчанию false — IP нужны
# для сетевой диагностики инцидентов (опциональный режим усиления).
REDACT_IPS=false

# --- Промты и LLM-контекст ---
# Список разрешённых CORS origins (JSON-массив). Для dev можно ["*"]
CORS_ORIGINS=["http://localhost:3000"]
# Максимальный размер контекста, передаваемого в LLM, в ТОКЕНАХ
# (точный подсчёт tiktoken cl100k_base; предотвращает переполнение контекстного окна)
MAX_CONTEXT_TOKENS=4000

# Журнал аудита диагностик (append-only JSON Lines): диагностика, guardrail-
# отклонения и webhook-батчи Alertmanager пишутся по одной JSON-строке
AUDIT_LOG_PATH=audit.jsonl

# --- OpenTelemetry (распределённый трейсинг) ---
# OTLP gRPC endpoint экспорта трейсов (Jaeger all-in-one: 4317).
# Раскомментируйте, чтобы спаны уходили в Jaeger/Tempo; без значения экспорт
# отключён (спаны собираются in-process, внешних эффектов нет).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Имя сервиса в UI трейсинга
OTEL_SERVICE_NAME=ai-agent-devops

# --- RAG: гибридный поиск (TF-IDF + векторные эмбеддинги) ---
# Включить векторную ветку гибридного RAG (при недоступности модели агент
# молча деградирует до чистого TF-IDF)
ENABLE_HYBRID_RAG=true
# Лёгкая модель sentence-transformers для эмбеддингов runbook'ов
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Slack-аппрув опасных рекомендаций ---
# Incoming webhook: куда слать "⚠️ Action Required: ... Approve or Reject?".
# Без значения агент логирует WARNING, диагноз помечается requires_approval=true
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# --- Rate limiting (slowapi) ---
# Redis URL для общего хранилища лимитов между инстансами API.
# Без значения — in-memory (MemoryStorage) в каждом процессе.
#RATE_LIMIT_REDIS_URL=redis://redis.monitoring.svc.cluster.local:6379

# --- OIDC-аутентификация и ролевая авторизация (src/auth.py) ---
# Включить проверку JWT для POST /diagnose и POST /webhook/alertmanager.
# false (по умолчанию) — аутентификация отключена, все эндпоинты работают
# как раньше (dev/CI/обратная совместимость). /health, /ready и /metrics
# не защищаются НИКОГДА (kubelet-пробы и Prometheus-scraping).
OIDC_ENABLED=false
# Issuer URL OIDC-провайдера (Keycloak/Auth0/Azure AD/Okta): используется для
# Discovery ({issuer}/.well-known/openid-configuration -> jwks_uri) и проверки
# claim `iss`. ОБЯЗАТЕЛЕН при OIDC_ENABLED=true (иначе fail-fast при старте).
# Примеры:
#   Keycloak:  https://keycloak.example.com/realms/devops
#   Auth0:     https://your-tenant.auth0.com/
#   Azure AD:  https://login.microsoftonline.com/{tenant-id}/v2.0
#OIDC_ISSUER_URL=https://keycloak.example.com/realms/devops
# Audience этого API (claim `aud`): идентификатор, под которым API
# зарегистрирован в провайдере. ОБЯЗАТЕЛЕН при OIDC_ENABLED=true.
#OIDC_AUDIENCE=ai-agent-devops-api
# Роли для POST /diagnose (claim `roles` или `groups` JWT; JSON-массив).
# Доступ: хотя бы одно совпадение, иначе 403.
ALLOWED_ROLES_DIAGNOSE=["sre-user", "sre-admin"]
# Роли для POST /webhook/alertmanager (JWT-путь аутентификации).
ALLOWED_ROLES_WEBHOOK=["alertmanager", "sre-admin"]
# Альтернативная аутентификация вебхука: shared-секрет в заголовке
# X-Webhook-Secret (constant-time сравнение) — для Alertmanager и других
# интеграций, которые не умеют подписывать JWT. Сгенерируйте стойкое
# значение, например: openssl rand -hex 32. Без значения способ отключён.
#WEBHOOK_SHARED_SECRET=change-me-strong-random-string
