# Репозиторий и история Git
.git
.gitignore

# Python-мусор
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Виртуальные окружения
.venv/
venv/
env/

# Секреты — НЕ включать в образ (пробрасываются через --env-file / compose)
.env
.env.*
!.env.example

# В образ попадает ТОЛЬКО код src/ и нужные конфиги (COPY в Dockerfile явный);
# всё остальное исключается из build-контекста ради скорости и размера.
tests/
docs/
eval/
ui/
scripts/
.github/
audit.jsonl
*.md
Makefile
pyproject.toml
Dockerfile
docker-compose.yml
.dockerignore

# IDE / ОС / логи
.idea/
.vscode/
*.swp
.DS_Store
*.log
logs/
